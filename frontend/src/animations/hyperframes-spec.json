{
  "$schema": "https://hyperframes.dev/schema/v1.json",
  "name": "repolens-pipeline-animation",
  "title": "RepoLens AST & Hybrid RRF Grounding Pipeline",
  "fps": 60,
  "width": 1920,
  "height": 1080,
  "durationSeconds": 8,
  "author": "RepoLens Architecture Team",
  "scenes": [
    {
      "id": "scene-ast-parsing",
      "name": "Tree-Sitter AST Decomposition",
      "start": 0,
      "duration": 2.0,
      "description": "Raw source files stream in and decompose into syntax-aware AST symbols (functions, classes, decorators)",
      "seekableElements": [
        { "selector": "#source-code-panel", "property": "opacity", "from": 0, "to": 1 },
        { "selector": "#ast-nodes-tree", "property": "transform", "from": "translateX(-40px)", "to": "translateX(0px)" },
        { "selector": ".ast-symbol-badge", "property": "scale", "from": 0.8, "to": 1.0 }
      ]
    },
    {
      "id": "scene-dual-indexing",
      "name": "Dual-Track Vector & Lexical Ingestion",
      "start": 2.0,
      "duration": 2.0,
      "description": "AST chunks bifurcate into dense 384-dimensional ONNX embeddings and BM25 inverted lexical keyword index",
      "seekableElements": [
        { "selector": "#dense-vector-track", "property": "box-shadow", "from": "0 0 0px", "to": "0 0 24px rgba(16,185,129,0.35)" },
        { "selector": "#lexical-bm25-track", "property": "box-shadow", "from": "0 0 0px", "to": "0 0 24px rgba(59,130,246,0.35)" },
        { "selector": ".flow-particles", "property": "stroke-dashoffset", "from": 100, "to": 0 }
      ]
    },
    {
      "id": "scene-hybrid-rrf",
      "name": "Reciprocal Rank Fusion (RRF)",
      "start": 4.0,
      "duration": 2.0,
      "description": "Dynamic ranking merging dense and lexical candidate lists using formula RRF(d) = sum(1 / (60 + r(d)))",
      "seekableElements": [
        { "selector": "#rrf-formula-banner", "property": "opacity", "from": 0, "to": 1 },
        { "selector": "#ranked-candidate-winner", "property": "transform", "from": "scale(0.9)", "to": "scale(1.0)" },
        { "selector": ".rank-bar", "property": "width", "from": "0%", "to": "100%" }
      ]
    },
    {
      "id": "scene-citation-gate",
      "name": "Deterministic Line Citation Gate",
      "start": 6.0,
      "duration": 2.0,
      "description": "Radar scanner checks code boundaries and emits verified [file:start-end] citation chips",
      "seekableElements": [
        { "selector": "#radar-sweep", "property": "rotate", "from": "0deg", "to": "360deg" },
        { "selector": "#verified-citation-pill", "property": "box-shadow", "from": "0 0 0px", "to": "0 0 30px rgba(16,185,129,0.5)" },
        { "selector": "#verification-checkmark", "property": "scale", "from": 0, "to": 1.2 }
      ]
    }
  ],
  "renderCommand": "npx hyperframes render src/animations/hyperframes-spec.json -o public/repolens-pipeline.mp4"
}
